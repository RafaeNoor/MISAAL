

;; Signed Widen Mul 
(rewrite
    (typed_signed-vec-widen-mul v1 v2 iprec isize)

    (typed_signed-vec-mul
        (typed_cast-int-extend v1 iprec 1 (/ isize iprec) (* iprec 2))
        (typed_cast-int-extend v2 iprec 1 (/ isize iprec) (* iprec 2))
        (* iprec 2) (* isize 2)
    )
)

(rewrite
    (typed_signed-vec-mul
        (typed_cast-int-extend v1 iprec isigned olane oprec)
        (typed_cast-int-extend v2 iprec isigned olane oprec)
        oprec osize 
    )

    (typed_signed-vec-widen-mul v1 v2 iprec (* iprec olane))
    )

;; Unsigned Widen Mul
(rewrite
    (typed_unsigned-vec-widen-mul v1 v2 iprec isize)

    (typed_unsigned-vec-mul
        (typed_cast-uint-extend v1 iprec 1 (/ isize iprec) (* iprec 2))
        (typed_cast-uint-extend v2 iprec 1 (/ isize iprec) (* iprec 2))
        (* iprec 2) (* isize 2)
    )
)


(rewrite
    (typed_unsigned-vec-mul
        (typed_cast-uint-extend v1 iprec isigned olane oprec)
        (typed_cast-uint-extend v2 iprec isigned olane oprec)
        oprec osize 
    )

    (typed_unsigned-vec-widen-mul v1 v2 iprec (* iprec olane))

)



;; Literals Casts
(rewrite
     (LIT val prec)
    (typed_cast-int-extend (LIT val (/ prec 2)) (/ prec 2) 1 1 prec)
    ;:when ((< val 255))
)

(rewrite
     (LIT val prec)
    (typed_cast-uint-extend (LIT val (/ prec 2)) (/ prec 2) 1 1 prec)
    ;:when ((< val 255))
)

;; Halide casts of broadcast is equal to broadcast of casts

(rewrite 
 (typed_xBroadcast
  (typed_cast-int-extend  reg_0 iprec 1 1 oprec)
  isize
  isize
  factor
 )

 (typed_cast-int-extend  
  (typed_xBroadcast
   reg_0
   iprec 
   iprec
   factor
  )

  iprec  1 factor oprec
 )

 )


(rewrite 
 (typed_xBroadcast
  (typed_cast-uint-extend  reg_0 iprec 1 1 oprec)
  isize
  isize
  factor
 )

 (typed_cast-uint-extend  
  (typed_xBroadcast
   reg_0
   iprec 
   iprec
   factor
  )

  iprec  1 factor oprec
 )

 )

;; Vector saturate
(rewrite
 (typed_cast-uint-truncate  
  (typed_signed-vec-max
   (typed_signed-vec-min
    reg_0
    (typed_xBroadcast (LIT "255" 16) 16 16 factor)
    16
    (* 16 factor)
   )
   (typed_xBroadcast (LIT "0" 16) 16 16 factor)
   16
   (* 16 factor)
  )
  16 1 factor 8 
 )
 (typed_vec-saturate  reg_0 16 1  factor 8 0)
 )

(rewrite
 (typed_cast-uint-truncate  
  (typed_signed-vec-max
   (typed_signed-vec-min
    reg_0
    (typed_xBroadcast (LIT "65535" 32) 32 32 factor)
    32
    (* 32 factor)
   )
   (typed_xBroadcast (LIT "0" 32) 32 32 factor)
   32
   (* 32 factor)
  )
  32 1 factor 16 
 )
 (typed_vec-saturate  reg_0 32 1  factor 16 0)
 )


 (rewrite
  (typed_cast-int-truncate  
   (typed_signed-vec-max
    (typed_signed-vec-min
     reg_0
     (typed_xBroadcast (LIT "32767" 32) 32 32 factor)
     32
     (* 32 factor)
    )
    (typed_xBroadcast (LIT "-32768" 32) 32 32 factor)
    32
    (* 32 factor)
   )
   32 1 factor 16 
  )
  (typed_vec-saturate  reg_0 32 1  factor 16 1)
 )


;; Vector saturate
(rewrite
 (typed_cast-int-truncate  
  (typed_signed-vec-max
   (typed_signed-vec-min
    reg_0
    (typed_xBroadcast (LIT "127" 16) 16 16 factor)
    16
    (* 16 factor)
   )
   (typed_xBroadcast (LIT "-128" 16) 16 16 factor)
   16
   (* 16 factor)
  )
  16 1 factor 8 
 )
 (typed_vec-saturate  reg_0 16 1  factor 8 1)
 )


